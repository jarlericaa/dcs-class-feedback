    "next": "^15.3.4",
    "next-auth": "5.0.0-beta.29",
    "nodemailer": "^6.10.1",
    "pdfkit": "^0.19.1",
    "pg": "^8.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "rehype-katex": "^7.0.1",
