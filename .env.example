# --- Database ---
DATABASE_URL=postgres://feedback:feedback@localhost:5432/feedback
# Used only by `npm run test:integration` (compose service db-test)
TEST_DATABASE_URL=postgres://feedback:feedback@localhost:5433/feedback_test
# Used only by `npm run test:e2e` (compose service db-e2e)
E2E_DATABASE_URL=postgres://feedback:feedback@localhost:5434/feedback_e2e

# --- Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Google OAuth credentials (Google Cloud Console > APIs & Services > Credentials,
# OAuth client type "Web application", redirect URI:
#   http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Comma-separated list of allowed Google account domains (university accounts).
# Sign-ins from any other domain are rejected.
ALLOWED_EMAIL_DOMAINS=up.edu.ph

# --- Institution ---
# Single institution timezone for MVP (Open D7: owner-confirmed Asia/Manila).
INSTITUTION_TIMEZONE=Asia/Manila

# --- Scheduler ---
# Shared secret for POST /api/internal/scheduler/tick
SCHEDULER_SECRET=

# --- Student-number protection at rest (project-specs.md §11) ---
# Two INDEPENDENT 32-byte keys, base64. Generate each with:
#   openssl rand -base64 32
# Required in production; dev/test fall back to fixed NON-SECRET keys so the
# suite runs without setup. Never reuse the dev defaults with real student data.
# Losing STUDENT_NUMBER_ENC_KEY makes existing student numbers unrecoverable;
# changing STUDENT_NUMBER_HASH_KEY invalidates every lookup hash (re-run the
# backfill script). Rotation procedure: docs/SECURITY.md.
STUDENT_NUMBER_ENC_KEY=
STUDENT_NUMBER_HASH_KEY=
# Set only while rotating the encryption key: decryption falls back to this.
STUDENT_NUMBER_ENC_KEY_PREVIOUS=

# --- Roster claiming (open-decisions.md D2) ---
# false = teacher-confirm-all (the approved default). true = auto-confirm a
# unique high-confidence name match at claim time.
ROSTER_CLAIM_AUTO_CONFIRM=false
ROSTER_CLAIM_AUTO_CONFIRM_MIN_SCORE=0.85
ROSTER_CLAIM_MAX_PER_HOUR=5

# --- Email notifications (project-specs.md §6.9) ---
# Absolute base URL used to build the authenticated links inside every email.
APP_BASE_URL=http://localhost:3000
# log = write to the server log and never send (safe default for development)
# fake = record in memory (tests only)
# smtp = really deliver (REQUIRED in production)
EMAIL_TRANSPORT=log
EMAIL_FROM=Class Feedback <no-reply@localhost>
# Used to build a deterministic Message-ID so a retried send is de-duplicated.
APP_MAIL_DOMAIN=localhost
EMAIL_MAX_ATTEMPTS=5
# Deadline reminders, as offsets before the deadline. Duplicates are ignored.
EMAIL_REMINDER_OFFSETS=24h,2h
EMAIL_BATCH_SIZE=50
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# --- Local development ONLY ---
# Dev login fallback when Google OAuth creds are unavailable.
# Hard-disabled in production regardless of this value (NODE_ENV check).
# Leave unset/false unless you are running locally without OAuth credentials.
DEV_AUTH_ENABLED=false
